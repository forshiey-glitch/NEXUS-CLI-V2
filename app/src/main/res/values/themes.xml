<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.NexusCLI" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/nexus_green</item>
        <item name="colorOnPrimary">@color/nexus_bg</item>
        <item name="colorSecondary">@color/nexus_cyan</item>
        <item name="colorOnSecondary">@color/nexus_bg</item>
        <item name="colorSurface">@color/nexus_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/nexus_bg</item>
        <item name="android:windowBackground">@drawable/bg_root_gradient</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Widget.Nexus.GlassCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/glass_fill</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

</resources>