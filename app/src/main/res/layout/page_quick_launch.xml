<?xml version="1.0" encoding="utf-8"?>
<com.nexus.cli.LongPressLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/quickTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:text="@string/quick_launch_title"
            android:textColor="@color/nexus_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/widgetContainer"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone" />

        <!--
            Kustomisasi HANYA via long press 5000 ms per widget
            (NexusUi.attachLongPress di NexusPagerAdapter).
            TIDAK ada pemicu swipe/scroll di sini.
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/quickGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:clipToPadding="false"
            android:padding="2dp" />

    </LinearLayout>
</com.nexus.cli.LongPressLayout>