<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <TextView android:id="@+id/quickTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:fontFamily="monospace" android:letterSpacing="0.2" android:text="QUICK LAUNCH" android:textColor="@color/nexus_green" android:textSize="12sp" android:textStyle="bold"/>
        <!--  GridLayout 4 kolom: ukuran widget (span kolom/baris) dihitung di NexusPagerAdapter  -->
        <GridLayout android:id="@+id/widgetContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:columnCount="4" android:visibility="gone"/>
        <GridLayout android:id="@+id/quickGrid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="2dp" android:layout_weight="1" android:columnCount="4" android:rowCount="3"/>
    </LinearLayout>
</FrameLayout>